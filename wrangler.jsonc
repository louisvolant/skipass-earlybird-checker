{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skipass-earlybird-checker",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skipass-earlybird-checker-d1",
      "database_id": "d980ce6d-f007-4ee2-aa4a-edf75e6017b1"
    }
  ],
  // Cloudflare Observability configuration
  // Enables log persistence and invocation logs for execution traces and unhandled exception diagnostics
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "keep_vars": true,
  "triggers": {
    "crons": [
      "0 7 * * *"
    ]
  }
}
