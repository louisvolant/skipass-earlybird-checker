{
  "name": "skipass-earlybird-checker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --no-warnings --test --experimental-strip-types \"src/**/*.test.ts\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --keep-vars",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.21.0",
    "htmlparser2": "^12.0.0",
    "mongoose": "^8.24.7",
    "next": "^16.3.1",
    "node-mailjet": "^6.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "daisyui": "^5.7.50",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  }
}
